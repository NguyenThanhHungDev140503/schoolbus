# ============================================
# School Bus Management System - Environment Variables
# ============================================
# Copy file này thành .env.development và điền các giá trị thực tế
# File này chứa các biến môi trường cần thiết để chạy dự án

# ============================================
# Database Configuration
# ============================================
# URL kết nối đến PostgreSQL database
# Format: postgresql://user:password@host:port/database
# Ví dụ: postgresql://postgres:password@localhost:5432/schoolbus
DATABASE_URL=postgresql://user:password@localhost:5432/schoolbus

# ============================================
# JWT Authentication
# ============================================
# Secret key để ký JWT tokens (nên dùng chuỗi ngẫu nhiên mạnh)
# Có thể generate bằng: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Thời gian hết hạn của JWT token
# Format: số + đơn vị (s, m, h, d)
# Ví dụ: 1d (1 ngày), 24h (24 giờ), 3600s (1 giờ)
JWT_EXPIRATION=1d

# ============================================
# Traccar GPS Integration
# ============================================
# Base URL của Traccar server
# Mặc định: http://demo.traccar.org (cho testing)
# Production: URL của Traccar server thực tế
TRACCAR_BASE_URL=http://demo.traccar.org

# Traccar authentication - Có thể dùng token HOẶC username/password
# Option 1: Sử dụng Token (khuyến nghị)
TRACCAR_TOKEN=your-traccar-api-token-here

# Option 2: Sử dụng Username/Password (nếu không có token)
# TRACCAR_USERNAME=your-traccar-email@example.com
# TRACCAR_EMAIL=your-traccar-email@example.com
# TRACCAR_PASSWORD=your-traccar-password

# ============================================
# Traccar Position Sender Configuration
# ============================================
# Bật/tắt tính năng gửi vị trí đến Traccar
# Giá trị: 'true' hoặc 'false' (mặc định: 'true')
TRACCAR_POSITION_SENDER_ENABLED=true

# Port để lắng nghe WebSocket từ Traccar (nếu cần)
# Mặc định: 5055
TRACCAR_POSITION_PORT=5055

# ============================================
# Notes
# ============================================
# 1. Không commit file .env.development vào Git (đã có trong .gitignore)
# 2. Mỗi developer cần tạo file .env.development riêng với giá trị thực tế
# 3. Đảm bảo DATABASE_URL trỏ đến database đúng
# 4. JWT_SECRET phải đủ mạnh và bảo mật
# 5. Traccar credentials cần được cấp từ admin Traccar server
